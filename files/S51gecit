#!/bin/sh
# gecit service: start|stop|restart|status|check [DOMAIN...]
PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONF=/opt/etc/gecit/gecit.conf
BIN=/opt/sbin/gecit
RULES=/opt/share/gecit/rules.sh
# In RAM: a power cut can't leave a stale pid behind for the next boot.
PIDF=/tmp/gecit.pid
# Keenetic keeps the time zone as a POSIX string in /etc/TZ, which the static binary only reads via $TZ.
[ -z "$TZ" ] && [ -r /etc/TZ ] && export TZ="$(cat /etc/TZ)"
export GECIT_CONF=$CONF

say() { echo "gecit: $*"; logger -t gecit "$*" 2>/dev/null; }

# Our supervisor, not just any process that happens to have the recorded pid.
running() {
  [ -f $PIDF ] || return 1
  p=$(cat $PIDF)
  [ -n "$p" ] && tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q "^$BIN run "
}

start() {
  running && { echo "gecit is already running"; return 0; }
  out=$($BIN validate -c $CONF 2>&1) || { say "not started: $out"; return 1; }
  eval "$($BIN shellvars -c $CONF)"
  [ "$ENABLED" = no ] && { say "not started: ENABLED=no in $CONF"; return 0; }
  $BIN run -c $CONF --syslog </dev/null >/dev/null 2>&1 &
  echo $! > $PIDF
  sleep 1
  running || { rm -f $PIDF; say "did not start; see the system log"; return 1; }
  # Rules only once the engine listens (they fail open anyway, thanks to --queue-bypass).
  $RULES add
  case $? in
    0) say "started" ;;
    # At boot the internet may not be up yet; rules.sh retries, and the NDM hook adds them too.
    3) say "started; rules follow when the internet connection is up" ;;
    *) say "could not add rules; stopping"; stop; return 1 ;;
  esac
}

stop() {
  # Drop the pid file first, so the NDM hook can't put the rules back while we stop.
  p=""; running && p=$(cat $PIDF)
  rm -f $PIDF
  $RULES del || say "some rules could not be removed"
  if [ -n "$p" ]; then
    kill "$p" 2>/dev/null
    for i in 1 2 3 4 5 6; do kill -0 "$p" 2>/dev/null || break; sleep 1; done
    kill -0 "$p" 2>/dev/null && kill -9 "$p"
  fi
  echo "gecit stopped"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    if running; then echo "gecit is running (pid $(cat $PIDF))"; else echo "gecit is not running"; exit 1; fi ;;
  check) shift; $BIN check -c $CONF "$@" ;;
  *) echo "usage: $0 start|stop|restart|status|check [DOMAIN...]"; exit 2 ;;
esac
